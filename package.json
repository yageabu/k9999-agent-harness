{
	"name": "k9999-agent-harness",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "An agent harness assembled on top of @earendil-works/pi-agent-core.",
	"license": "MIT",
	"workspaces": [
		"packages/*"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"k9999": "node --env-file-if-exists=.env packages/cli/src/index.ts",
		"eval": "node --env-file-if-exists=.env packages/eval/src/cli.ts",
		"eval:scripts": "node packages/eval/scripts/build-task-scripts.mjs",
		"typecheck": "tsc --noEmit",
		"test": "node --test \"packages/*/test/*.test.ts\"",
		"check:site": "node scripts/check-site.mjs site",
		"check": "npm run typecheck && npm run test && npm run check:site",
		"pdf": "playwright pdf site/index.html k9999.pdf",
		"publish:github": "node scripts/publish-github-packages.mjs"
	},
	"devDependencies": {
		"@earendil-works/pi-tui": "^1.0.2",
		"@types/node": "^22.18.0",
		"esbuild": "^0.28.2",
		"typescript": "^5.9.2"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "^1.0.2",
		"@earendil-works/pi-ai": "^1.0.2",
		"typebox": "^1.3.27"
	}
}
