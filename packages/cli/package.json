{
	"name": "k9999",
	"version": "0.5.0",
	"description": "An agent harness that never blocks on a human. Two agents — k9999 writes code, kula reads data — built on @earendil-works/pi-agent-core.",
	"type": "module",
	"license": "MIT",
	"bin": {
		"k9999": "dist/index.js",
		"kula": "dist/index.js"
	},
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yageabu/k9999-agent-harness.git",
		"directory": "packages/cli"
	},
	"homepage": "https://yageabu.github.io/k9999-agent-harness/",
	"bugs": {
		"url": "https://github.com/yageabu/k9999-agent-harness/issues"
	},
	"keywords": [
		"agent",
		"harness",
		"coding-agent",
		"data-analysis",
		"cli",
		"llm",
		"typescript"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "node ../../scripts/build-package.mjs",
		"preview": "node scripts/render-preview.ts",
		"prepublishOnly": "npm run build && npm --prefix ../.. run check"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "^1.0.2",
		"@earendil-works/pi-ai": "^1.0.2",
		"@earendil-works/pi-tui": "^1.0.2",
		"typebox": "^1.3.27"
	},
	"devDependencies": {
		"@k9999/core": "*"
	}
}
