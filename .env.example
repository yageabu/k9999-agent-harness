# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so it
# documents what the harness needs without carrying a secret.
#
# The provider reads this name directly. There is no config file: an agent that
# silently loads environment variables from whatever directory it runs in is an
# agent that can be redirected by a repository it was asked to inspect, so only
# the development scripts load a `.env` at all (see AGENTS.md).
DEEPSEEK_API_KEY=

# Optional.
# K9999_MODEL=deepseek/deepseek-v4-pro
# K9999_PROFILES=./profiles
